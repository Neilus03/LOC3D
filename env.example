# Source this file from the repository root after editing the data locations.
# Dependency checkouts, weights and generated files are ignored by Git.
export DELIMIT3D_PROJECT_ROOT="$PWD"
# Legacy runtime identity keeps existing default artifact paths stable.
# LOC3D is the public project name; override this only for a new run identity.
export DELIMIT3D_NAME=Delimit3D
export DELIMIT3D_WORK_ROOT="$DELIMIT3D_PROJECT_ROOT/data"
export DELIMIT3D_RUN_ROOT="$DELIMIT3D_PROJECT_ROOT/runs"
export DELIMIT3D_OUTPUT_DIR="$DELIMIT3D_RUN_ROOT/sam2_pretraining"

# Locked external source checkouts and public weights.
export DELIMIT3D_LITEPT_ROOT="$DELIMIT3D_PROJECT_ROOT/.deps/LitePT"
export DELIMIT3D_CONCERTO_ROOT="$DELIMIT3D_PROJECT_ROOT/.deps/Concerto"
export DELIMIT3D_SONATA_ROOT="$DELIMIT3D_PROJECT_ROOT/.deps/Sonata"
export DELIMIT3D_SAM2_ROOT="$DELIMIT3D_PROJECT_ROOT/.deps/SAM2"
export DELIMIT3D_UNSAM_ROOT="$DELIMIT3D_PROJECT_ROOT/.deps/UnSAMv2"
export DELIMIT3D_CONCERTO_CHECKPOINT="$DELIMIT3D_PROJECT_ROOT/.deps/weights/concerto_small.pth"
export DELIMIT3D_SONATA_CHECKPOINT="$DELIMIT3D_PROJECT_ROOT/.deps/weights/sonata_small.pth"
export DELIMIT3D_SAM2_CHECKPOINT="$DELIMIT3D_PROJECT_ROOT/.deps/weights/sam2_1_hiera_large.pt"
export UNSAM_ROOT="$DELIMIT3D_UNSAM_ROOT"
export UNSAMV2_CKPT="$DELIMIT3D_PROJECT_ROOT/.deps/weights/unsamv2_plus_ckpt.pt"

# Raw Structured3D data and prepared 2D-only inputs.
export DELIMIT3D_STRUCTURED3D_ROOT="$DELIMIT3D_WORK_ROOT/structured3d_raw"
export DELIMIT3D_RAW_ZIPS="$DELIMIT3D_STRUCTURED3D_ROOT"
export DELIMIT3D_GEOMETRY_ROOT="$DELIMIT3D_WORK_ROOT/structured3d_geometry"
export DELIMIT3D_ANNOTATION_ROOT="$DELIMIT3D_WORK_ROOT/sam2_annotations"
export DELIMIT3D_SOURCE_ROOT="$DELIMIT3D_WORK_ROOT/sam2_sources"
export DELIMIT3D_UNSAM_PROPOSALS="$DELIMIT3D_WORK_ROOT/unsamv2_proposals"
export DELIMIT3D_TRAIN_SPLIT="$DELIMIT3D_PROJECT_ROOT/configs/splits/structured3d_train.txt"
export DELIMIT3D_VAL_SPLIT="$DELIMIT3D_PROJECT_ROOT/configs/splits/structured3d_val.txt"
export DELIMIT3D_SOURCE_AUDIT="$DELIMIT3D_WORK_ROOT/source_audit.json"
export DELIMIT3D_CODE_MANIFEST="$DELIMIT3D_WORK_ROOT/code_manifest.json"
export DELIMIT3D_FIXED_EVAL="$DELIMIT3D_WORK_ROOT/fixed_eval"
export DELIMIT3D_CALIBRATION="$DELIMIT3D_WORK_ROOT/multiscale_calibration.json"
export DELIMIT3D_BACKBONE_CHECKPOINT="$DELIMIT3D_PROJECT_ROOT/checkpoints/litept_backbone.pt"

# ScanNet and downstream task inputs.
export DELIMIT3D_SCANNET_ROOT="$DELIMIT3D_WORK_ROOT/scannet_raw/scans"
export DELIMIT3D_MASK3D_SCANS="$DELIMIT3D_WORK_ROOT/mask3d/scans"
export DELIMIT3D_MASK3D_GT_CACHE="$DELIMIT3D_WORK_ROOT/mask3d/targets"
export DELIMIT3D_MASK3D_TRAIN_SPLIT="$DELIMIT3D_PROJECT_ROOT/configs/splits/scannet_train.txt"
export DELIMIT3D_MASK3D_VAL_SPLIT="$DELIMIT3D_PROJECT_ROOT/configs/splits/scannet_val.txt"
export DELIMIT3D_MASK3D_DECODER="$DELIMIT3D_PROJECT_ROOT/checkpoints/mask3d_decoder.pt"

# Paths inside the downloaded official AGILE3D benchmark; edit to its layout.
export DELIMIT3D_AGILE3D_SCANS="$DELIMIT3D_WORK_ROOT/agile3d/scannet/processed"
export DELIMIT3D_AGILE3D_TRAIN_LIST="$DELIMIT3D_WORK_ROOT/agile3d/scannet/train.json"
export DELIMIT3D_AGILE3D_VAL_LIST="$DELIMIT3D_WORK_ROOT/agile3d/scannet/val.json"
export DELIMIT3D_AGILE3D_NORMALS="$DELIMIT3D_WORK_ROOT/agile3d/normals"
export DELIMIT3D_AGILE3D_OBJECTS="$DELIMIT3D_WORK_ROOT/agile3d/scannet/single_object"
export DELIMIT3D_AGILE3D_DECODER="$DELIMIT3D_PROJECT_ROOT/checkpoints/agile3d_decoder.pt"
