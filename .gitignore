.ruff_cache/
.venv/
venv/
.env
/.deps/
/data/
/checkpoints/
*.egg-info/
build/
dist/

# Never put private data, checkpoints, or generated run output in Git.
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
*.ply
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.csv
*.jsonl
*.log
*.out
*.err
/runs/
/features/
/exports/
/reports/generated/
/artifacts/
/results/
/mesh_visuals/
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz

# Keep small, hand-authored manifests and examples versioned.
!manifests/*.json
!configs/**/*.json
!tests/fixtures/**/*.json
