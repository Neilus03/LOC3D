{
  "dataset": "structured3d",
  "litept_variant": "litept_s_star",
  "expected_world_size": 2,
  "rank_balance_policy": "rotating_local_padding_v1",
  "input_features": "rgbn6",
  "grid_size": 0.02,
  "representative_sampling": "first",
  "color_mean": [0, 0, 0],
  "color_std": [1, 1, 1],
  "train_augmentation_profile": "mask3d_scannet_rgbn6_fullscene_v1",
